              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "SESSION_NOT_FOUND": {
                    "value": {
                      "code": "SESSION_NOT_FOUND",
                      "message": "Session was not found."
                    }
                  },
                  "REGISTRATION_NOT_FOUND": {
                    "value": {
                      "code": "REGISTRATION_NOT_FOUND",
                      "message": "Registration was not found under this session."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCoach": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Must contain a non-whitespace character."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "Coach": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Must contain a non-whitespace character."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "CreateParticipant": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Must contain a non-whitespace character."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "Participant": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Must contain a non-whitespace character."
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "CreateSession": {
        "type": "object",
        "required": [
          "coachId",
          "startTime",
          "endTime",
          "capacity",
          "location"
        ],
        "properties": {
          "coachId": {
            "type": "string",
            "format": "uuid"
          },
          "startTime": {
            "type": "string",
