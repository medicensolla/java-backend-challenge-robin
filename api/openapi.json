{
  "openapi": "3.0.3",
  "info": {
    "title": "Java Backend Challenge API",
    "version": "0.1.0",
    "description": "Sports training scheduling and registration API. JBC-006 implements coach and participant creation; session and registration routes remain planned. Creation responses include UUID IDs. Baseline errors use application/json with stable codes and optional fieldErrors. Essential decisions remain versioned here because Markdown documentation is ignored at the owner's request."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local service after database configuration; business endpoints arrive in subsequent tickets."
    }
  ],
  "tags": [
    {
      "name": "Coaches"
    },
    {
      "name": "Participants"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Registrations"
    }
  ],
  "paths": {
    "/api/coaches": {
      "post": {
        "operationId": "createCoach",
        "summary": "Create a coach",
        "tags": [
          "Coaches"
        ],
        "description": "Name and email must be nonblank; email must be valid. Emails are not unique identities. Public name remains compatible after schema evolution.",
        "responses": {
          "201": {
            "description": "Resource created; body includes its ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coach"
                },
                "example": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "name": "Alex Rivera",
                  "email": "alex@example.com"
                }
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  },
                  "invalidFields": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains invalid fields.",
                      "fieldErrors": [
                        {
                          "field": "email",
                          "message": "must be a valid email"
                        }
                      ]
                    }
                  },
                  "malformedJson": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request body must contain valid JSON."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCoach"
              },
              "example": {
                "name": "Alex Rivera",
                "email": "alex@example.com"
              }
            }
          }
        }
      }
    },
    "/api/participants": {
      "post": {
