                },
                "examples": {
                  "SESSION_NOT_FOUND": {
                    "value": {
                      "code": "SESSION_NOT_FOUND",
                      "message": "Session was not found."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/registrations/{registrationId}": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "registrationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "operationId": "cancelRegistration",
        "summary": "Cancel a registration",
        "tags": [
          "Registrations"
        ],
        "description": "Check session existence, then registration membership. Missing registration or one belonging to another session returns 404. Delete the relationship, freeing capacity; registering again creates a new ID. Repeated cancellation returns 404.",
        "responses": {
          "204": {
            "description": "Deleted; no response body."
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
