                }
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  },
                  "invalidFields": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains invalid fields.",
                      "fieldErrors": [
                        {
                          "field": "email",
                          "message": "must be a valid email"
                        }
                      ]
                    }
                  },
                  "malformedJson": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request body must contain valid JSON."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateParticipant"
              },
              "example": {
                "name": "Sam Lee",
                "email": "sam@example.com"
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create a session",
        "tags": [
          "Sessions"
        ],
        "description": "Validate input, then coach existence, then overlap. For the same coach, overlap is existing.start < proposed.end AND proposed.start < existing.end. Adjacent intervals are allowed; different coaches may share an interval. Serialize check/insert by locking the coach row.",
        "responses": {
          "201": {
            "description": "Resource created; body includes its ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                },
                "example": {
                  "id": "33333333-3333-4333-8333-333333333333",
                  "coachId": "11111111-1111-4111-8111-111111111111",
                  "startTime": "2026-10-05T14:00:00Z",
                  "endTime": "2026-10-05T15:00:00Z",
                  "capacity": 10,
                  "location": "Court A"
                }
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "COACH_NOT_FOUND": {
                    "value": {
                      "code": "COACH_NOT_FOUND",
                      "message": "Coach was not found."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "COACH_OVERLAP": {
                    "value": {
                      "code": "COACH_OVERLAP",
                      "message": "Coach already has a session overlapping this interval."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSession"
              },
              "example": {
                "coachId": "11111111-1111-4111-8111-111111111111",
                "startTime": "2026-10-05T10:00:00-04:00",
                "endTime": "2026-10-05T11:00:00-04:00",
                "capacity": 10,
                "location": "Court A"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSessions",
        "summary": "List and filter sessions",
        "tags": [
          "Sessions"
        ],
        "description": "Optional filters combine with AND. Select interval intersections: endTime > from and startTime < to for supplied bounds. Reject from >= to. Order by startTime then id. No matches, including an unknown coach filter, returns []. No pagination in the baseline.",
        "responses": {
          "200": {
            "description": "Successful query.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                },
                "example": [
                  {
                    "id": "33333333-3333-4333-8333-333333333333",
                    "coachId": "11111111-1111-4111-8111-111111111111",
                    "startTime": "2026-10-05T14:00:00Z",
                    "endTime": "2026-10-05T15:00:00Z",
                    "capacity": 10,
                    "location": "Court A"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "coachId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Exact coach ID."
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "T.*(?:Z|[+-]\\d{2}:\\d{2})$",
              "description": "ISO-8601 with explicit offset. Responses are normalized to UTC Z."
            },
            "description": "Exclusive test against session end; offset required."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "T.*(?:Z|[+-]\\d{2}:\\d{2})$",
              "description": "ISO-8601 with explicit offset. Responses are normalized to UTC Z."
            },
            "description": "Exclusive upper bound against session start; offset required."
          }
        ]
      }
    },
    "/api/sessions/{sessionId}": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "operationId": "deleteSession",
        "summary": "Delete an empty session",
        "tags": [
          "Sessions"
        ],
        "description": "Check session existence first. Block while any registrations exist; restrictive foreign keys protect against concurrent relationship changes. After cancellation of all registrations, deletion succeeds. Repeated deletion returns 404.",
        "responses": {
          "204": {
            "description": "Deleted; no response body."
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "SESSION_NOT_FOUND": {
                    "value": {
                      "code": "SESSION_NOT_FOUND",
                      "message": "Session was not found."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "SESSION_HAS_REGISTRATIONS": {
                    "value": {
                      "code": "SESSION_HAS_REGISTRATIONS",
                      "message": "Cancel all registrations before deleting this session."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{sessionId}/registrations": {
      "parameters": [
        {
          "name": "sessionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createRegistration",
        "summary": "Register a participant",
        "tags": [
          "Registrations"
        ],
        "description": "Check in order: input validation, session existence, participant existence, duplicate, capacity. Duplicate takes precedence over full. The last available slot succeeds. A database unique constraint protects participant/session pairs; translate its violation to DUPLICATE_REGISTRATION. Transactional baseline capacity checking does not guarantee capacity under concurrent requests; optional JBC-017 adds that guarantee.",
        "responses": {
          "201": {
            "description": "Resource created; body includes its ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                },
                "example": {
                  "id": "44444444-4444-4444-8444-444444444444",
                  "sessionId": "33333333-3333-4333-8333-333333333333",
                  "participantId": "22222222-2222-4222-8222-222222222222"
                }
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Request contains malformed or invalid fields."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "SESSION_NOT_FOUND": {
                    "value": {
                      "code": "SESSION_NOT_FOUND",
                      "message": "Session was not found."
                    }
                  },
                  "PARTICIPANT_NOT_FOUND": {
                    "value": {
                      "code": "PARTICIPANT_NOT_FOUND",
                      "message": "Participant was not found."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "DUPLICATE_REGISTRATION": {
                    "value": {
                      "code": "DUPLICATE_REGISTRATION",
                      "message": "Participant is already registered for this session."
                    }
                  },
                  "SESSION_FULL": {
                    "value": {
                      "code": "SESSION_FULL",
                      "message": "Session has reached its capacity."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegistration"
              },
              "example": {
                "participantId": "22222222-2222-4222-8222-222222222222"
              }
            }
          }
        }
      }
    },
