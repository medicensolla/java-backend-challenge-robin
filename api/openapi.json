          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
