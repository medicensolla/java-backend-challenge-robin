      "get": {
        "operationId": "listSessionParticipants",
        "summary": "List registered participants",
        "tags": [
          "Registrations"
        ],
        "description": "Include participant id, name, email and registrationId for discoverable cancellation. Order by participant id. An existing empty session returns []; a missing session returns 404. One read-only transaction checks existence then fetches registrations with participants through an EntityGraph, avoiding per-participant queries.",
