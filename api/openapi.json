                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegisteredParticipant"
                  }
                },
                "example": [
                  {
                    "id": "22222222-2222-4222-8222-222222222222",
                    "name": "Sam Lee",
                    "email": "sam@example.com",
                    "registrationId": "44444444-4444-4444-8444-444444444444"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "See error codes and examples.",
