      ],
      "delete": {
        "operationId": "cancelRegistration",
        "summary": "Cancel a registration",
        "tags": [
          "Registrations"
        ],
        "description": "Check session existence, then execute a single delete scoped by sessionId and registrationId in one transaction. Missing registration or one belonging to another session returns 404. Delete only the relationship, freeing capacity; registering again creates a new ID. Repeated cancellation returns 404. Preserve participants and other registrations.",
        "responses": {
          "204": {
            "description": "Deleted; no response body."
          },
          "400": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidUuid": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Bad Request"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "SESSION_NOT_FOUND": {
                    "value": {
                      "code": "SESSION_NOT_FOUND",
                      "message": "Session was not found."
                    }
                  },
                  "REGISTRATION_NOT_FOUND": {
                    "value": {
                      "code": "REGISTRATION_NOT_FOUND",
                      "message": "Registration was not found under this session."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "See error codes and examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "message": "An unexpected error occurred."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCoach": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
