# Examples for an isolated local development database, not production credentials.
# Compose loads .env automatically; direct Spring Boot startup requires exporting it.
# Compose sets its own internal DB_URL and PORT. PORT below selects the host port.
DB_NAME=jbc
DB_URL=jdbc:postgresql://localhost:5432/jbc
DB_USERNAME=jbc_local
DB_PASSWORD=local_development_only
PORT=8080
